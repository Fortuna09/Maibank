# Copie para .env (desenvolvimento). Em produção, cadastre as mesmas variáveis na Vercel.

# Banco. Local: o Postgres do infra/docker-compose.yml. Produção: a connection string
# "pooled" do Neon (termina com ?sslmode=require).
DATABASE_URL=postgres://maibank:maibank@localhost:5432/maibank

# Segredo que assina os tokens de sessão. Obrigatório em produção; gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Endereço público do app (vai nos links dos e-mails). Na Vercel pode ficar vazio:
# usa o domínio de produção do projeto automaticamente.
APP_URL=http://localhost:4200

# E-mail. Sem nada configurado, os e-mails não saem: o link aparece no console do backend.
# Opção grátis — Gmail: ative a verificação em duas etapas na conta Google e crie uma
# "senha de app" (myaccount.google.com/apppasswords). O remetente é a própria conta.
SMTP_USER=
SMTP_PASS=
# Opção com domínio próprio — Resend (sem domínio verificado só entrega para o dono da conta):
RESEND_API_KEY=
# Remetente (Resend com domínio, ex.: Maibank <nao-responda@seudominio.com.br>). No Gmail, deixe vazio.
EMAIL_FROM=

# Fuso usado para "hoje" (salário automático). Padrão: America/Sao_Paulo.
APP_TIMEZONE=America/Sao_Paulo

PORT=3001

# Contas com acesso à Administração (mensagens para quem usa o app), separadas por vírgula
ADMIN_EMAILS=seu-email@gmail.com
