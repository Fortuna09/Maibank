# Copie para .env (desenvolvimento). Em produção, cadastre as mesmas variáveis na Vercel.

# Banco. Local: o Postgres do infra/docker-compose.yml. Produção: a connection string
# "pooled" do Neon (termina com ?sslmode=require).
DATABASE_URL=postgres://maibank:maibank@localhost:5432/maibank

# Segredo que assina os tokens de sessão. Obrigatório em produção; gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Endereço público do app (vai nos links dos e-mails). Na Vercel pode ficar vazio:
# usa o domínio de produção do projeto automaticamente.
APP_URL=http://localhost:4200

# E-mail (Resend). Sem chave, os e-mails não saem: o link aparece no console do backend.
RESEND_API_KEY=
# Sem domínio verificado no Resend, deixe o padrão — só entrega para o seu próprio e-mail.
EMAIL_FROM=Maibank <onboarding@resend.dev>

# Fuso usado para "hoje" (salário automático). Padrão: America/Sao_Paulo.
APP_TIMEZONE=America/Sao_Paulo

PORT=3001
